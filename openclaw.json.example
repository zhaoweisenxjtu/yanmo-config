{
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "sandbox": {
        "browser": {
          "enabled": false
        }
      },
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": [
          "deepseek/deepseek-v4-pro"
        ]
      },
      "userTimezone": "Asia/Shanghai",
      "timeFormat": "24",
      "timeoutSeconds": 3600,
      "bootstrapMaxChars": 20000,
      "bootstrapTotalMaxChars": 40000,
      "thinkingDefault": "high",
      "compaction": {
        "mode": "safeguard",
        "recentTurnsPreserve": 5,
        "keepRecentTokens": 8000,
        "reserveTokens": 4000,
        "notifyUser": true
      },
      "memorySearch": {
        "enabled": true,
        "store": {
          "vector": {
            "extensionPath": "/root/.local/share/pnpm/global/5/.pnpm/sqlite-vec-linux-x64@0.1.9/node_modules/sqlite-vec-linux-x64/vec0.so"
          }
        }
      },
      "heartbeat": {
        "every": "2h",
        "activeHours": {
          "start": "08:00",
          "end": "23:00"
        }
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "alias": "Flash",
          "params": {
            "temperature": 0.1,
            "max_tokens": 4096
          }
        },
        "deepseek/deepseek-v4-pro": {
          "alias": "Pro",
          "params": {
            "temperature": 0.3,
            "max_tokens": 16384
          }
        }
      },
      "params": {
        "temperature": 0.2,
        "top_p": 0.9,
        "frequency_penalty": 0.5
      },
      "reasoningDefault": "on",
      "verboseDefault": "off"
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "__REPLACE_ME__"
    },
    "port": 12643,
    "bind": "lan",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowedOrigins": [
        "http://124.221.148.237:12643"
      ],
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true,
      "basePath": "/9enbuq"
    }
  },
  "session": {
    "dmScope": "main",
    "maintenance": {
      "pruneAfter": "14d",
      "maxEntries": 500
    },
    "reset": {
      "mode": "daily",
      "atHour": 4,
      "idleMinutes": 60
    }
  },
  "tools": {
    "profile": "full"
  },
